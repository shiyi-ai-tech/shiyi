# 史佚 (ShiYi) 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ── 必需：LLM API Key ──
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-api-key-here

# ── 可选：主 LLM 配置 ──
# 默认使用 deepseek-v4-pro，可通过以下变量覆盖
# SHIYI_MAIN_LLM_MODEL=deepseek-v4-pro
# SHIYI_MAIN_API_BASE=https://api.deepseek.com/v1

# ── 可选：轻量 LLM 配置（意图识别等感知层） ──
# 默认使用 deepseek-v4-flash
# SHIYI_LIGHT_LLM_MODEL=deepseek-v4-flash
# SHIYI_LIGHT_API_BASE=https://api.deepseek.com/v1
# SHIYI_LIGHT_API_KEY=  # 默认复用 DEEPSEEK_API_KEY

# ── 可选：Embedding 配置（向量记忆搜索） ──
# 默认使用 SiliconFlow BAAI/bge-m3
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=  # 默认复用 DEEPSEEK_API_KEY
